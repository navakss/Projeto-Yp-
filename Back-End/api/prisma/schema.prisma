generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Produto {
  id          Int         @id @default(autoincrement())
  codigo      String      @unique @db.VarChar(8)
  nome        String
  categoria   String
  status      String      @default("Indefinido")

  processos   Processo[]
}

model Processo {
  id                    Int       @id @default(autoincrement())

  temperatura           Int
  nivelMicrobiologico   Int

  produtoId             Int
  produto               Produto   @relation(fields: [produtoId], references: [id])

  createdAt             DateTime  @default(now())
}